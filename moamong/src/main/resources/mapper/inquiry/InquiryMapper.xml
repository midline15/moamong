<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mori.moamong.inquiry.mapper.InquiryMapper">

    <!-- 1:1문의 검색 조건 (공통) -->
    <sql id="inquiryWhere">
        <where>
            <!-- 내 문의만 보기 (memberId 있을 때) -->
            <if test="memberId != null and memberId != ''">
                MEMBER_ID = #{memberId}
            </if>
            <if test="keyword != null and keyword != ''">
                AND INQ_TITLE LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </sql>

    <!-- 1:1문의 목록 조회 (최신순) -->
    <select id="selectInquiryList" parameterType="hashmap" resultType="com.mori.moamong.dto.Inquiry">
        SELECT *
        FROM INQ
        <include refid="inquiryWhere"/>
        ORDER BY INQ_ID DESC
        LIMIT #{startNum}, #{pageSize}
    </select>

    <!-- 1:1문의 전체 개수 -->
    <select id="selectInquiryCnt" parameterType="hashmap" resultType="int">
        SELECT COUNT(*)
        FROM INQ
        <include refid="inquiryWhere"/>
    </select>

    <!-- 1:1문의 상세 조회 -->
    <select id="selectInquiry" parameterType="hashmap" resultType="com.mori.moamong.dto.Inquiry">
        SELECT *
        FROM INQ
        WHERE INQ_ID = #{inqId}
    </select>

    <!-- 1:1문의 등록 (처음엔 답변 대기: WAIT) -->
    <insert id="insertInquiry" parameterType="hashmap">
        INSERT INTO INQ (
            MEMBER_ID, INQ_TITLE, INQ_CONTENT, INQ_STATUS, CREATED_AT
        ) VALUES (
            #{memberId}, #{inqTitle}, #{inqContent}, 'WAIT', NOW()
        )
    </insert>

    <!-- 1:1문의 수정 (답변 대기 상태에서만) -->
    <update id="updateInquiry" parameterType="hashmap">
        UPDATE INQ
        SET INQ_TITLE = #{inqTitle},
            INQ_CONTENT = #{inqContent}
        WHERE INQ_ID = #{inqId}
          AND INQ_STATUS = 'WAIT'
    </update>

    <!-- 1:1문의 답변 등록/수정 (상태 DONE 으로 변경) -->
    <update id="updateInquiryAnswer" parameterType="hashmap">
        UPDATE INQ
        SET ADMIN_ID = #{adminId},
            ANSWER_CONTENT = #{answerContent},
            INQ_STATUS = 'DONE',
            ANSWERED_AT = NOW()
        WHERE INQ_ID = #{inqId}
    </update>

    <!-- 1:1문의 삭제 -->
    <delete id="deleteInquiry" parameterType="hashmap">
        DELETE FROM INQ
        WHERE INQ_ID = #{inqId}
    </delete>

</mapper>