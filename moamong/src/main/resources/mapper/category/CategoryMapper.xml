<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mori.moamong.category.mapper.CategoryMapper">
   <!-- TODO: MyBatis SQL statements -->
   <select id="selectMainCategoryList" parameterType="hashmap" resultType="Category">
       select * from CATEGORY 
       where category_depth = 1 
   </select>
   
      <select id="selectSubCategoryList" resultType="Category"> 
         SELECT * FROM CATEGORY
          WHERE parent_category_id = #{categoryId} 
            AND category_depth = 2 
   </select>
</mapper>