<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mori.moamong.notice.mapper.NoticeMapper">

    <!-- 공지사항 검색 조건 (공통) -->
    <sql id="noticeWhere">
        <where>
            <if test="keyword != null and keyword != ''">
                NOTICE_TITLE LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </sql>

    <!-- 공지사항 목록 조회 (고정글 먼저, 그 다음 최신순) -->
    <select id="selectNoticeList" parameterType="hashmap" resultType="com.mori.moamong.dto.Notice">
        SELECT *
        FROM NOTICE
        <include refid="noticeWhere"/>
        ORDER BY IS_PINNED DESC, NOTICE_ID DESC
        LIMIT #{startNum}, #{pageSize}
    </select>

    <!-- 공지사항 전체 개수 -->
    <select id="selectNoticeCnt" parameterType="hashmap" resultType="int">
        SELECT COUNT(*)
        FROM NOTICE
        <include refid="noticeWhere"/>
    </select>

    <!-- 공지사항 상세 조회 -->
    <select id="selectNotice" parameterType="hashmap" resultType="com.mori.moamong.dto.Notice">
        SELECT *
        FROM NOTICE
        WHERE NOTICE_ID = #{noticeId}
    </select>

    <!-- 조회수 증가 -->
    <update id="updateNoticeViewCount" parameterType="hashmap">
        UPDATE NOTICE
        SET VIEW_COUNT = VIEW_COUNT + 1
        WHERE NOTICE_ID = #{noticeId}
    </update>

    <!-- 공지사항 등록 -->
    <insert id="insertNotice" parameterType="hashmap">
        INSERT INTO NOTICE (
            ADMIN_ID, NOTICE_TITLE, NOTICE_CONTENT, IS_PINNED,
            VIEW_COUNT, CREATED_AT, UPDATED_AT
        ) VALUES (
            #{adminId}, #{noticeTitle}, #{noticeContent}, #{isPinned},
            0, NOW(), NOW()
        )
    </insert>

    <!-- 공지사항 수정 -->
    <update id="updateNotice" parameterType="hashmap">
        UPDATE NOTICE
        SET NOTICE_TITLE = #{noticeTitle},
            NOTICE_CONTENT = #{noticeContent},
            IS_PINNED = #{isPinned},
            UPDATED_AT = NOW()
        WHERE NOTICE_ID = #{noticeId}
    </update>

    <!-- 공지사항 삭제 -->
    <delete id="deleteNotice" parameterType="hashmap">
        DELETE FROM NOTICE
        WHERE NOTICE_ID = #{noticeId}
    </delete>

</mapper>