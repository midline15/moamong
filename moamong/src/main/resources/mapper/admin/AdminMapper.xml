<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mori.moamong.admin.mapper.AdminMapper">


    <!-- ==========================================
         1. 회원 목록 조회
         ========================================== -->

    <select id="selectAdminList"
        parameterType="hashmap"
        resultType="com.mori.moamong.admin.model.Admin">
		
		    SELECT
		        M.*,
		
		        <!-- 회원 등급 정보를 가져옵니다. -->
		        MG.*,
		
		        <!-- 회원 등급 이름을 Admin의 memberGrade 필드에 연결합니다. -->
		        MG.grade_name AS memberGrade,
		
		        <!-- 회원별 누적 구매 금액을 조회합니다.
		             구매 내역이 없는 회원은 0원으로 표시합니다. -->
		        COALESCE(O.total_payment, 0) AS total_payment
		
		    FROM MEMBER M
		
		    <!-- 회원 등급 정보 조회 -->
		    LEFT JOIN MEMBERSHIP_GRADE MG
		        ON M.member_id = MG.member_id
		
		    <!-- 회원별 누적 구매 금액 조회 -->
		    LEFT JOIN (
		        SELECT
		            member_id,
		            SUM(final_amount) AS total_payment
		        FROM ORDERS
		        GROUP BY member_id
		    ) O
		        ON M.member_id = O.member_id
		
		    <!-- 검색 조건 -->
		    <where>
		
		        <!-- 이름, 아이디, 이메일 검색 -->
		        <if test="keyword != null and keyword != ''">
		            AND (
		                M.member_name LIKE CONCAT('%', #{keyword}, '%')
		                OR M.login_id LIKE CONCAT('%', #{keyword}, '%')
		                OR M.email LIKE CONCAT('%', #{keyword}, '%')
		            )
		        </if>
		
		        <!-- 회원 등급 검색 -->
		        <if test="searchGrade != null and searchGrade != ''">
		            AND MG.grade_name = #{searchGrade}
		        </if>
		
		        <!-- 회원 상태 검색 -->
		        <if test="searchStatus != null and searchStatus != ''">
		            <choose>
		                <when test="searchStatus == '정상'">
		                    AND M.status = 'ACTIVE'
		                </when>
		
		                <when test="searchStatus == '휴면'">
		                    AND M.status = 'WITHDRAWN'
		                </when>
		            </choose>
		        </if>
		
		        <!-- 가입 기간 검색 -->
		        <if test="searchPeriod != null and searchPeriod != ''">
		
		            <!-- 오늘 가입 -->
		            <if test="searchPeriod == 'today'">
		                AND M.CREATED_AT >= CURDATE()
		                AND M.CREATED_AT &lt; CURDATE() + INTERVAL 1 DAY
		            </if>
		
		            <!-- 최근 7일 가입 -->
		            <if test="searchPeriod == 'week'">
		                AND M.CREATED_AT >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)
		                AND M.CREATED_AT &lt; CURDATE() + INTERVAL 1 DAY
		            </if>
		
		            <!-- 최근 30일 가입 -->
		            <if test="searchPeriod == 'month'">
		                AND M.CREATED_AT >= DATE_SUB(CURDATE(), INTERVAL 29 DAY)
		                AND M.CREATED_AT &lt; CURDATE() + INTERVAL 1 DAY
		            </if>
		
		        </if>
		
		    </where>
		
		    <!-- 최신 가입 회원이 먼저 나오도록 정렬 -->
		    ORDER BY M.CREATED_AT DESC, M.MEMBER_ID DESC
		
		    <!-- 한 페이지에 보여줄 회원 수 -->
		    LIMIT #{limit}
		
		    <!-- 조회 시작 위치 -->
		    OFFSET #{offset}

    </select>


    <!-- ==========================================
         2. 전체 회원 수 조회
         ========================================== -->

	   <select id="selectAdminCount"
	        parameterType="hashmap"
	        resultType="int">
	
	    SELECT COUNT(*)
	
	    FROM MEMBER M
	
	    <!-- 회원 등급 정보 조회 -->
	    LEFT JOIN MEMBERSHIP_GRADE MG
	        ON M.member_id = MG.member_id
	
	    <where>
	
	        <!-- 이름, 아이디, 이메일 검색 -->
	        <if test="keyword != null and keyword != ''">
	            AND (
	                M.member_name LIKE CONCAT('%', #{keyword}, '%')
	                OR M.login_id LIKE CONCAT('%', #{keyword}, '%')
	                OR M.email LIKE CONCAT('%', #{keyword}, '%')
	            )
	        </if>
	
	        <!-- 회원 등급 검색 -->
	        <if test="searchGrade != null and searchGrade != ''">
	            AND MG.grade_name = #{searchGrade}
	        </if>
	
	        <!-- 회원 상태 검색 -->
	        <!-- 목록 조회와 동일하게 한글 값을 DB 상태값으로 변환합니다. -->
	        <if test="searchStatus != null and searchStatus != ''">
	            <choose>
	                <when test="searchStatus == '정상'">
	                    AND M.status = 'ACTIVE'
	                </when>
	
	                <when test="searchStatus == '휴면'">
	                    AND M.status = 'WITHDRAWN'
	                </when>
	            </choose>
	        </if>
	
	        <!-- 가입 기간 검색 -->
	        <if test="searchPeriod != null and searchPeriod != ''">
	
	            <!-- 오늘 가입 -->
	            <if test="searchPeriod == 'today'">
	                AND M.CREATED_AT >= CURDATE()
	                AND M.CREATED_AT &lt; CURDATE() + INTERVAL 1 DAY
	            </if>
	
	            <!-- 최근 7일 가입 -->
	            <if test="searchPeriod == 'week'">
	                AND M.CREATED_AT >= DATE_SUB(CURDATE(), INTERVAL 6 DAY)
	                AND M.CREATED_AT &lt; CURDATE() + INTERVAL 1 DAY
	            </if>
	
	            <!-- 최근 30일 가입 -->
	            <if test="searchPeriod == 'month'">
	                AND M.CREATED_AT >= DATE_SUB(CURDATE(), INTERVAL 29 DAY)
	                AND M.CREATED_AT &lt; CURDATE() + INTERVAL 1 DAY
	            </if>
	
	        </if>
	
	    </where>
	
	</select>

    <!-- ==========================================
         3. 회원 통계 조회
         ========================================== -->

    <select id="selectStats"
            parameterType="hashmap"
            resultType="com.mori.moamong.admin.model.Admin">

        SELECT

            <!--전체 회원 수-->
            COUNT(*) AS totalCount,

           <!-- 오늘 가입한 회원 수-->
            SUM(
                CASE
                    WHEN CREATED_AT >= CURDATE()
                     AND CREATED_AT &lt; CURDATE() + INTERVAL 1 DAY
                    THEN 1 ELSE 0
                END
            ) AS todayCount,

            <!-- 활성 회원 수-->
            SUM(
                CASE
                    WHEN status = 'ACTIVE'
                    THEN 1 ELSE 0
                END
            ) AS activeCount,

            <!-- 탈퇴 회원 수-->
            SUM(
                CASE
                    WHEN status = 'WITHDRAWN'
                    THEN 1 ELSE 0
                END
            ) AS dormantCount

        FROM MEMBER

    </select>
    
    
<!-- ==========================================
     4. 회원 상세정보 조회
     ========================================== -->

<select id="selectAdminDetail"
        parameterType="hashmap"
        resultType="com.mori.moamong.admin.model.Admin">

    SELECT

        <!-- 회원 기본 정보를 가져옵니다. -->
        M.*,

        <!-- 회원 등급 이름을 가져옵니다. -->
        MG.grade_name AS memberGrade,

        <!-- 누적 구매 금액을 가져옵니다.
             주문 내역이 없으면 0으로 표시합니다. -->
        COALESCE(O.total_payment, 0) AS totalPayment,

        <!-- 누적 주문 건수를 가져옵니다.
             주문 내역이 없으면 0으로 표시합니다. -->
        COALESCE(O.order_count, 0) AS orderCount

    FROM MEMBER M

    <!-- 회원 등급 정보를 연결합니다. -->
    LEFT JOIN MEMBERSHIP_GRADE MG
        ON M.member_id = MG.member_id

    <!-- 회원별 주문 통계를 가져옵니다. -->
    LEFT JOIN (
        SELECT
            member_id,
            SUM(final_amount) AS total_payment,
            COUNT(*) AS order_count
        FROM ORDERS
        GROUP BY member_id
    ) O
        ON M.member_id = O.member_id

    <!-- JSP에서 전달한 회원 번호와 일치하는 회원을 조회합니다. -->
    WHERE M.member_id = #{memberId}

</select>

	    
         
         

</mapper>
